        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\n    USER[\&quot;Internet Users\&quot;]\n    R53[\&quot;Route 53\&quot;]\n    ALB[\&quot;Application Load Balancer\&quot;]\n\n    USER --&gt; R53 --&gt; ALB\n\n    subgraph AWS[\&quot;AWS Region\&quot;]\n        subgraph VPC[\&quot;VPC 10.0.0.0/16\&quot;]\n\n            IGW[\&quot;Internet Gateway\&quot;]\n            NAT[\&quot;NAT Gateway\&quot;]\n\n            subgraph AZ1[\&quot;Availability Zone 1\&quot;]\n\n                PUB1[\&quot;Public Subnet\&quot;]\n                APP1[\&quot;Private App Subnet\&quot;]\n                EC2A[\&quot;EC2\&quot;]\n\n                DB1[\&quot;Private DB Subnet\&quot;]\n\n            end\n\n            subgraph AZ2[\&quot;Availability Zone 2\&quot;]\n\n                PUB2[\&quot;Public Subnet\&quot;]\n                APP2[\&quot;Private App Subnet\&quot;]\n                EC2B[\&quot;EC2\&quot;]\n\n                DB2[\&quot;Private DB Subnet\&quot;]\n\n            end\n\n            ALB --&gt; EC2A\n            ALB --&gt; EC2B\n\n            EC2A --&gt; RDS\n            EC2B --&gt; RDS\n\n            IGW --&gt; ALB\n            EC2A --&gt; NAT\n            EC2B --&gt; NAT\n\n            RDS[\&quot;RDS MySQL&lt;br/&gt;Multi-AZ\&quot;]\n\n        end\n    end\n\n    SG[\&quot;Security Groups&lt;br/&gt;ALB → EC2 → RDS\&quot;]\n\n    IAM[\&quot;IAM Role + SSM\&quot;]\n    SM[\&quot;Secrets Manager\&quot;]\n\n    CW[\&quot;CloudWatch\&quot;]\n    SNS[\&quot;SNS Alerts\&quot;]\n\n    EC2A --&gt; CW\n    EC2B --&gt; CW\n    RDS --&gt; CW\n    CW --&gt; SNS\n\n    IAM -.-&gt; EC2A\n    IAM -.-&gt; EC2B\n    SM -.-&gt; RDS\n\n    TF[\&quot;Terraform&lt;br/&gt;Infrastructure as Code\&quot;]\n\n    TF -. provisions .-&gt; VPC\n    SG -. controls .-&gt; ALB\n    SG -. controls .-&gt; EC2A\n    SG -. controls .-&gt; EC2B\n    SG -. controls .-&gt; RDS&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="sPCCKy_GE0oi3YNiW4I4-1">
